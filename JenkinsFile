pipeline {
agent any

stages {
    stage('Build') {
        steps {
            echo 'Task: Compile source code and package application.'
            echo 'Tool: Apache Maven (mvn clean package)'
        }
    }
    stage('Unit and Integration Tests') {
        steps {
            echo 'Task: Run unit and integration test suites to verify application logic.'
            echo 'Tools: JUnit, TestNG'
        }
    }
    stage('Code Analysis') {
        steps {
            echo 'Task: Static code analysis for quality, code smells, and standards.'
            echo 'Tool: SonarQube'
        }
    }
    stage('Security Scan') {
        steps {
            echo 'Task: Vulnerability scanning for dependencies and code flaws.'
            echo 'Tool: OWASP Dependency-Check'
        }
    }
    stage('Deploy to Staging') {
        steps {
            echo 'Task: Deploy build artifacts to pre-production staging environment.'
            echo 'Tool: AWS EC2 / Docker'
        }
    }
    stage('Integration Tests on Staging') {
        steps {
            echo 'Task: Validate deployed application functionality in a production-like environment.'
            echo 'Tool: Postman / Selenium'
        }
    }
    stage('Deploy to Production') {
        steps {
            echo 'Task: Release application to live production environment.'
            echo 'Tool: AWS EC2'
        }
    }
}
}
